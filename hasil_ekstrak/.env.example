# ==============================================================================
# BOZAGENTIC — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the placeholders with your actual API keys.
# ==============================================================================

# --- [1. LLM GATEWAY & PROVIDER CONFIGURATION] ---
# Primary Gateway: 9Router / OmniRouter Local Proxy
ROUTER_BASE_URL="http://localhost:20128/v1"
ROUTER_API_KEY="sk-bozagentic-local-token"

# Fallback Cloud Providers (Optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# --- [2. STEALTH BROWSER & AUTOMATION] ---
# Camoufox CDP / Headless Browser Config
BROWSER_HEADLESS="true"
BROWSER_USER_DATA_DIR="./data/browser_profile"
CAPTCHA_SOLVER_API_KEY=""

# --- [3. WEB3 & ON-CHAIN RPC ENDPOINTS] ---
ETHEREUM_RPC_URL="https://eth.llamarpc.com"
BASE_RPC_URL="https://mainnet.base.org"
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Treasury & Operational Wallets (Public Addresses)
TREASURY_PUBLIC_ADDRESS=""
OPERATOR_PUBLIC_ADDRESS=""

# --- [4. SOCIAL MEDIA & NOTIFICATION BOT CREDENTIALS] ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID=""
DISCORD_WEBHOOK_URL=""

# --- [5. OPSEC & RUNTIME GOVERNANCE] ---
# Spend Governor Limits (USD Equivalent)
MAX_DAILY_GAS_SPEND_USD="50.0"
REQUIRE_CONFIRMATION_ABOVE_USD="25.0"
LOG_LEVEL="INFO"
